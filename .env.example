# Powers the "now playing" command palette action + persistent nav widget
# (app/api/now-playing/route.ts). Uses Last.fm's recent-tracks API (free,
# no OAuth) instead of Spotify's own API — Last.fm just needs to be
# connected to your Spotify account as a scrobbler. Get a key at
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=

# In-page 30s preview playback is resolved through Apple's iTunes Search
# API (itunes.apple.com/search) — no key, no auth, nothing to configure.
# Spotify's own Web API was tried first but now requires the developer
# app's owner to have an active Premium subscription for any request,
# including keyless search, so it's not usable here.
