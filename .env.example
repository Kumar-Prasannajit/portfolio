# Powers the "now playing" command palette action + persistent nav widget
# (app/api/now-playing/route.ts). Uses Last.fm's recent-tracks API (free,
# no OAuth) instead of Spotify's own API — Last.fm just needs to be
# connected to your Spotify account as a scrobbler. Get a key at
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=

# In-page 30s preview playback is resolved through Apple's iTunes Search
# API (itunes.apple.com/search) — no key, no auth, nothing to configure.
# Spotify's own Web API was tried first but now requires the developer
# app's owner to have an active Premium subscription for any request,
# including keyless search, so it's not usable here.

# The "viewers" number in the home page's left panel (app/api/views/route.ts).
# A plain counter, one per browser, stored in Upstash Redis (free tier is
# plenty): create a database at https://upstash.com (or add the Upstash
# integration in the Vercel dashboard, which sets KV_REST_API_URL and
# KV_REST_API_TOKEN, also accepted) and paste its REST URL and token.
# Without these the panel shows "not connected" in production; in development
# it counts into .data/views.json so it works with no setup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rail 3's WATCHING row (app/api/rail-stats/route.ts, docs/redesign-spec.md
# phase 3): the anime currently in your AniList "Watching" list. Public
# GraphQL API, no auth — just your username. Without this the row is left
# out (the stats grid sizes to the rows it shows).
ANILIST_USERNAME=

# Optional. Rail 3's LAST COMMIT and DEPLOYED rows and the Stack section's
# "last used" call the GitHub API, unauthenticated by default (60/hr, often
# exhausted on shared hosting IPs). Tokens raise that to 5000/hr and let the
# Stack read private repos.
# Only repos owned by ALLOWED_OWNERS (lib/githubTools.ts) are ever read: your
# account and salonjaa-digital-solution, plus the public repos named in
# ALLOWED_REPOS there (projects on other people's accounts; no token needed).
# Employer orgs are deliberately left out. Any push to an allowed repo counts, a teammate's included. Only tool
# names and dates reach the page.
#
# Use fine-grained tokens (github.com/settings/personal-access-tokens/new),
# read-only. Each one covers a single owner, hence two:
#   GITHUB_TOKEN           resource owner: your account
#   GITHUB_TOKEN_SALONJAA  resource owner: salonjaa-digital-solution
# Both: Repository access "All repositories"; permissions Metadata: Read-only
# and Contents: Read-only. Nothing else.
# A single classic PAT with `repo` in GITHUB_TOKEN also works, but it grants
# write access to every repo you can reach, employer ones included.
GITHUB_TOKEN=
GITHUB_TOKEN_SALONJAA=
